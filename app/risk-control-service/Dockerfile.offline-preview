FROM golang:1.26-alpine AS builder
WORKDIR /src
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=$GOPROXY
COPY app/risk-control-service/go.mod app/risk-control-service/go.sum ./
RUN go mod download
COPY app/risk-control-service ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/offline-risk ./cmd/offline-risk

FROM alpine:3.22
COPY --from=builder /out/offline-risk /offline-risk
